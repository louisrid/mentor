{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mentor",
  "version": "0.1.5",
  "identifier": "com.louis.mentor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mentor",
        "width": 520,
        "height": 640,
        "minWidth": 380,
        "minHeight": 400,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Your private, direct AI mentor",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
